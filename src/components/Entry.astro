---
import Chips from './Chips.astro';
import { formatDate, isoDate } from '../lib/format';
import type { TopicSlug } from '../data/topics';

interface Props {
  title: string;
  href: string;
  date: Date;
  minutes: number;
  description: string;
  topics: TopicSlug[];
  /** Heading level, so nesting stays correct per page. */
  level?: 2 | 3;
  /** Drops the description and tightens spacing, for dense lists. */
  compact?: boolean;
}
const {
  title,
  href,
  date,
  minutes,
  description,
  topics,
  level = 2,
  compact = false,
} = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---

<li class:list={['entry', compact && 'entry--compact']}>
  <Heading class="entry__title"><a href={href}>{title}</a></Heading>
  <p class="entry__meta">
    <time datetime={isoDate(date)}>{formatDate(date)}</time> · {minutes} min
  </p>
  <p class="entry__desc">{description}</p>
  {!compact && <Chips topics={topics} />}
</li>
